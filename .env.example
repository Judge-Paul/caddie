# Cloudflare Workers AI credentials.
#
# These are server-side only: copy this file to .env.local, fill it in, and only
# the Bun server (server/) reads them. Never prefix them with VITE_, which would
# ship the token to the browser.

CF_ACCOUNT_ID=
CF_API_KEY=

# Optional. Clef-flash checks pasted text before Gemma classifies it, so a CV,
# cover letter or link never reaches the classifier.
# CF_CLEF_MODEL=@cf/cloudflare/clef-flash

# Optional. Company research uses Browserbase Search + Fetch to read public
# company pages. Leave empty to disable research.
BROWSERBASE_API_KEY=

# Optional. LibreOffice binary used to render uploaded DOCX CVs.
# SOFFICE_BIN=soffice

# Optional. The Gemma classifier is the default; JEV is billed as a third-party
# model and needs Cloudflare credits (or a BYOK key) on the account.
# CF_GEMMA_MODEL=@cf/google/gemma-4-26b-a4b-it
# CF_JEV_MODEL=typesafe/jev-1.14.0

# Port for the classifier API. Vite proxies /api here in dev and preview.
# PORT=8787

# Accounts and applications (Better Auth + MongoDB).
# Use an Atlas connection string or a local MongoDB for development.
MONGODB_URI=
# MONGODB_DB=caddie
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (not the API port). Google redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:5173
